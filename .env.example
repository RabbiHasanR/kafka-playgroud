# Copy to .env before `docker compose up`. .env is gitignored; this file is not.
#
# Spec 003 introduces the only credentials in this repository. docker-compose.yml reads
# all three with the `${VAR:?...}` form, so a missing value fails at `up` with a message
# naming the variable — rather than silently starting with a default password, which is
# a hardcoded credential wearing a friendlier shape (003 D13).

# --- spec 003: the durable consumer state store ---------------------------------
POSTGRES_USER=order_service
POSTGRES_PASSWORD=change-me-before-first-run
POSTGRES_DB=order_state

# Host port only — the container always listens on 5432, so STATE_DB_DSN never changes.
# Set this if you already run Postgres locally; `up` fails with "address already in
# use" otherwise.
#POSTGRES_HOST_PORT=5433

# --- optional levers ------------------------------------------------------------
# Set to any non-empty value to give each notification instance a stable
# group.instance.id, so a restart returns it to its own partitions (002 D10).
#STATIC_MEMBERSHIP=1
